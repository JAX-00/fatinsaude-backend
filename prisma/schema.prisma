generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     String? 
  latitude  Float?
  longitude Float?
  hospitals Hospital[]
}

model Hospital {
  id            Int @id @default(autoincrement())
  name          String
  image         String?
  latitude      Float
  longitude     Float
  phone         String?
  emergency     Boolean @default(false)
  ambulance     String?
  diseases      Json?
  operationTime String?
  type          HospitalType?
  ownership     Ownership? @default(GOVERNO)
  districtId    Int
  district      District @relation(fields: [districtId], references: [id])

  @@unique([name, districtId])
}

enum HospitalType {
  HOSPITAL
  CLINIC
  CENTRO
  APOTIK
}

enum Ownership {
  GOVERNO
  PRIVADU
  ONG
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model Education {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // e.g., "First Aid", "CPR"
  description String?
  content     String?   @db.Text
  image       String?
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
